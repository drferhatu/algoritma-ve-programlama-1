// Hafta 5: iyi bir istemin dört parçası (rol, görev, biçim, bağlam) ve ortadaki soru (dot yerleşimi)
digraph Istem {
    charset="UTF-8";
    rankdir=TB;
    nodesep=0.6;
    ranksep=0.5;
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f4f1fb", color="#5b4b8a", width=2.3, height=1.0, fixedsize=true];
    edge [color="#5b4b8a", arrowhead=none];

    { rank=same; rol; gorev; }
    rol    [label="ROL\nkim cevaplıyor?\n\"Java hocası gibi davran\""];
    gorev  [label="GÖREV\nne yapsın?\n\"switch'i if/else ile karşılaştır\""];

    merkez [label="İSTEM\n\"switch nedir?\"", shape=ellipse, fillcolor="#fde9d9", color="#b5541c", width=2.0, height=0.9];

    { rank=same; bicim; baglam; }
    bicim  [label="BİÇİM\nnasıl versin?\n\"5 satır + 1 örnek + 1 soru\""];
    baglam [label="BAĞLAM\nben kimim, neredeyim?\n\"1. sınıf, if/else biliyorum\""];

    rol -> merkez;
    gorev -> merkez;
    merkez -> bicim;
    merkez -> baglam;
}
