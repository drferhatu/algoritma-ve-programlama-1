// Hafta 8: iç içe döngü; dış döngünün her turunda iç döngü baştan sona döner
digraph IcIce {
    charset="UTF-8";
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    basla   [shape=box, label="i = 1"];
    dis     [shape=diamond, label="DIŞ KOŞUL\ni <= 3 mü?"];
    icbasla [shape=box, label="j = 1\n(iç döngü her seferinde baştan)"];
    ic      [shape=diamond, label="İÇ KOŞUL\nj <= 4 mü?"];
    govde   [shape=box, label="GÖVDE\n(i, j) ile iş yap"];
    icadim  [shape=box, label="j++"];
    disadim [shape=box, label="satırı bitir\ni++"];
    son     [shape=box, style="rounded", label="döngülerden sonraki satır"];

    basla -> dis;
    dis -> icbasla [label="true"];
    icbasla -> ic;
    ic -> govde [label="true"];
    govde -> icadim;
    icadim -> ic [label="iç tur", color="#6d4bb5", fontcolor="#6d4bb5"];
    ic -> disadim [label="false"];
    disadim -> dis [label="dış tur", color="#b5541c", fontcolor="#b5541c"];
    dis -> son [label="false"];
}
