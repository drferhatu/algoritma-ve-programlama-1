// Hafta 9: çalışma akışı; main çağrıya gelince metoda gider, metot bitince çağrının yapıldığı yere döner
digraph Akis {
    charset="UTF-8";
    rankdir=LR;
    node [fontname="Helvetica", fontsize=11, shape=box];
    edge [fontname="Helvetica", fontsize=10];

    subgraph cluster_main {
        label="main"; fontname="Helvetica"; fontsize=11; style="rounded"; color="#34466e";
        m1 [label="1) \"Basla\" yaz"];
        m2 [label="2) cizgi() çağır"];
        m3 [label="5) \"Bitti\" yaz"];
        m1 -> m2 -> m3 [style=dashed, color="#9aa3b5"];
    }
    subgraph cluster_cizgi {
        label="cizgi"; fontname="Helvetica"; fontsize=11; style="rounded"; color="#b5541c";
        c1 [label="3) yirmi tire yaz"];
        c2 [label="4) metot bitti"];
        c1 -> c2;
    }
    m2 -> c1 [label="git", color="#b5541c", fontcolor="#b5541c"];
    c2 -> m3 [label="geri dön", color="#b5541c", fontcolor="#b5541c"];
}
