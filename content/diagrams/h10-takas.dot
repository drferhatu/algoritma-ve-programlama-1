// Hafta 10: değer ile geçirme; takas kendi kağıdındaki kopyaları değiştirir, main'in kutuları olduğu gibi kalır
digraph Takas {
    charset="UTF-8";
    rankdir=TB;
    ranksep=0.3;
    nodesep=0.3;
    node [shape=record, fontname="Helvetica", fontsize=11];
    edge [style=invis];

    subgraph cluster_takas {
        label="takas · metot bitmek üzere; kopyalar yer değiştirdi";
        fontname="Helvetica"; fontsize=11; style=rounded; color="#b5541c"; fontcolor="#b5541c";
        t [label="{a | 7} | {b | 3} | {gecici | 3}"];
    }
    subgraph cluster_main {
        label="main · asıl kutulara kimse dokunmadı";
        fontname="Helvetica"; fontsize=11; style=rounded; color="#34466e"; fontcolor="#34466e";
        m [label="{x | 3} | {y | 7}"];
    }
    t -> m;
}
