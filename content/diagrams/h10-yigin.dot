// Hafta 10: yığın diyagramı; ebob çalışmaya başladığı anda yığında üç kağıt var, en üstteki çalışıyor
digraph Yigin {
    charset="UTF-8";
    rankdir=TB;
    ranksep=0.3;
    nodesep=0.3;
    node [shape=record, fontname="Helvetica", fontsize=11];
    edge [style=invis];

    subgraph cluster_ebob {
        label="ebob · en üstteki kağıt, şu an çalışan";
        fontname="Helvetica"; fontsize=11; style=rounded; color="#b5541c"; fontcolor="#b5541c";
        e [label="{a | 12} | {b | 18}"];
    }
    subgraph cluster_ekok {
        label="ekok · ebob'un dönmesini bekliyor";
        fontname="Helvetica"; fontsize=11; style=rounded; color="#34466e"; fontcolor="#34466e";
        k [label="{a | 12} | {b | 18} | {ortak | ?}"];
    }
    subgraph cluster_main {
        label="main · ekok'un dönmesini bekliyor";
        fontname="Helvetica"; fontsize=11; style=rounded; color="#9ca3af"; fontcolor="#6b7280";
        m [label="{x | 12} | {y | 18} | {sonuc | ?}"];
    }
    e -> k -> m;
}
