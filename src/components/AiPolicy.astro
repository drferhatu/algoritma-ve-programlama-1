---
/** Yapay zeka kullanım politikası: trafik ışığı (kırmızı / sarı / yeşil) üç kart. course.json → aiPolicy */
import { aiPolicy } from '@/lib/site';
interface Props { compact?: boolean; heading?: string; }
const { compact = false, heading = 'Yapay zeka kullanımı: trafik ışığı' } = Astro.props;
const ORDER = ['kirmizi', 'sari', 'yesil'] as const;
const levels = ORDER.map((id) => aiPolicy.levels.find((l) => l.id === id)).filter(Boolean) as typeof aiPolicy.levels;
const ICON: Record<string, string> = {
  kirmizi: 'M6 6l12 12M18 6 6 18',
  sari: 'M12 8v5M12 16h.01M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0z',
  yesil: 'M5 12l5 5L20 7',
};
---
{levels.length > 0 && (
  <section aria-labelledby="yz-politika" class="not-prose">
    {!compact && (
      <div class="mb-6">
        <p class="eyebrow">Yapay zeka politikası</p>
        <h2 id="yz-politika" class="display mt-1 text-2xl md:text-3xl">{heading}</h2>
        {aiPolicy.intro && <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-2">{aiPolicy.intro}</p>}
      </div>
    )}
    {compact && <h2 id="yz-politika" class="sr-only">{heading}</h2>}
    <ul class="grid gap-4 md:grid-cols-3">
      {levels.map((l) => (
        <li class:list={['flex h-full flex-col rounded-2xl border-2 bg-white p-5 shadow-soft', `ai-${l.id}`]} style="border-color: var(--lvl)">
          <div class="flex items-center gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-full text-white" style="background: var(--lvl)" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[l.id]} /></svg>
            </span>
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.14em]" style="color: var(--lvl)">{l.id === 'kirmizi' ? 'Kırmızı' : l.id === 'sari' ? 'Sarı' : 'Yeşil'}</p>
              <h3 class="font-display text-lg font-semibold leading-tight text-ink">{l.label}</h3>
            </div>
          </div>
          <dl class="mt-4 space-y-3 text-[14px] leading-relaxed">
            <div><dt class="text-xs font-semibold uppercase tracking-wider text-ink-3">Nerede</dt><dd class="text-ink">{l.where}</dd></div>
            <div class="rounded-lg px-3 py-2" style="background: var(--lvl-soft)"><dt class="text-xs font-semibold uppercase tracking-wider" style="color: var(--lvl)">Kural</dt><dd class="text-ink">{l.rule}</dd></div>
            {!compact && <div><dt class="text-xs font-semibold uppercase tracking-wider text-ink-3">Neden</dt><dd class="text-ink-2">{l.why}</dd></div>}
          </dl>
        </li>
      ))}
    </ul>
  </section>
)}
