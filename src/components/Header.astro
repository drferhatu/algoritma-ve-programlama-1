---
import { course, href } from '@/lib/site';

const nav = [
  { label: 'Ders Hakkında', path: '/ders-hakkinda' },
  { label: 'Ders Akışı', path: '/ders-akisi' },
  { label: 'Haftalar', path: '/haftalar' },
  { label: 'Rehberler', path: '/rehberler' },
  { label: 'Kaynaklar', path: '/kaynaklar' },
  { label: 'Duyurular', path: '/duyurular' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (p: string) => current === href(p).replace(/\/$/, '') || current.startsWith(href(p) + '/');
---
<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/85 backdrop-blur supports-[backdrop-filter]:bg-paper/70">
  <div id="reading-progress" class="absolute inset-x-0 top-0 h-[2px] bg-accent" aria-hidden="true"></div>
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href={href('/')} class="group flex items-center gap-3 font-display text-lg font-semibold tracking-tight text-ink">
      <span class="grid size-9 place-items-center rounded-lg bg-ink text-paper transition-colors group-hover:bg-accent" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 4c-2 0-3 1-3 3v2c0 1.5-1 2.5-2 3 1 .5 2 1.5 2 3v2c0 2 1 3 3 3" />
          <path d="M16 4c2 0 3 1 3 3v2c0 1.5 1 2.5 2 3-1 .5-2 1.5-2 3v2c0 2-1 3-3 3" />
          <circle cx="12" cy="12" r="1.4" fill="var(--color-accent)" stroke="none" />
        </svg>
      </span>
      <span class="hidden sm:inline">{course.title}</span>
      <span class="sm:hidden">{course.shortTitle}</span>
    </a>

    <nav aria-label="Ana menü" class="hidden md:flex items-center gap-1">
      {nav.map((n) => (
        <a
          href={href(n.path)}
          aria-current={isActive(n.path) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3.5 py-2 text-sm font-medium transition-colors',
            isActive(n.path) ? 'bg-ink text-paper' : 'text-ink-2 hover:bg-paper-2 hover:text-ink',
          ]}
        >{n.label}</a>
      ))}
      <button id="yansi-toggle" type="button" class="ml-1 inline-flex h-9 items-center gap-1.5 rounded-full border border-line-2 px-3 text-xs font-semibold text-ink-2 hover:border-ink hover:text-ink" aria-pressed="false" title="Yansı modu: yüksek kontrast, büyük yazı (Alt+Y)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
        Yansı
      </button>
      <a href={href('/arama')} class="ml-2 grid size-9 place-items-center rounded-full border border-line-2 text-ink-2 hover:border-ink hover:text-ink" aria-label="Ara">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
    </nav>

    <button id="nav-toggle" class="md:hidden grid size-10 place-items-center rounded-full border border-line-2 text-ink" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menüyü aç">
      <svg class="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="icon-close hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobil menü" class="hidden md:hidden border-t border-line bg-paper">
    <div class="wrap flex flex-col py-3">
      {nav.map((n) => (
        <a href={href(n.path)} aria-current={isActive(n.path) ? 'page' : undefined}
           class:list={['rounded-lg px-3 py-3 text-base font-medium', isActive(n.path) ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2']}>{n.label}</a>
      ))}
      <a href={href('/arama')} class="rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-paper-2">Ara</a>
      <button id="yansi-toggle-m" type="button" class="rounded-lg px-3 py-3 text-left text-base font-medium text-ink hover:bg-paper-2" aria-pressed="false">Yansı modu</button>
    </div>
  </nav>
</header>

<script>
  // Yansı modu: html[data-yansi="on"]; localStorage + Alt+Y + ?yansi=1
  const setYansi = (on: boolean) => {
    document.documentElement.toggleAttribute('data-yansi', on);
    if (on) document.documentElement.setAttribute('data-yansi', 'on');
    try { localStorage.setItem('yansi', on ? 'on' : 'off'); } catch {}
    for (const id of ['yansi-toggle', 'yansi-toggle-m']) {
      const b = document.getElementById(id);
      b?.setAttribute('aria-pressed', String(on));
      if (id === 'yansi-toggle-m' && b) b.textContent = on ? 'Yansı modunu kapat' : 'Yansı modu';
    }
  };
  const isYansi = () => document.documentElement.getAttribute('data-yansi') === 'on';
  setYansi(isYansi());
  for (const id of ['yansi-toggle', 'yansi-toggle-m']) document.getElementById(id)?.addEventListener('click', () => setYansi(!isYansi()));
  document.addEventListener('keydown', (e) => { if (e.altKey && (e.key === 'y' || e.key === 'Y')) { e.preventDefault(); setYansi(!isYansi()); } });

  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
    btn.querySelector('.icon-open')?.classList.toggle('hidden', open);
    btn.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });

  // Okuma ilerlemesi: yalnızca data-reading-progress olan sayfalarda
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector<HTMLElement>('[data-reading-progress]');
  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>
