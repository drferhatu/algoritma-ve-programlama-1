---
/**
 * Kapsül: tek fikirlik, kısa ders kartı.
 * MDX'te kullanım:
 *   <Kapsul n={3} title="for: üç parça tek satırda" fikir="Kaç tur döneceği belliyse for.">
 *     ...markdown / kod...
 *   </Kapsul>
 * İsteğe bağlı şeritler: dene (Playground'da ne yapılacak), sor (giriş cümlesi) + istem (kopyalanabilir istem metni), dogrula (cevabı neyle sınayacak).
 * Her kapsül 2-4 dakikada okunur; ayrıntı yerine tek fikir + tek kod + tek deneme.
 */
interface Props { n?: number | string; title: string; fikir?: string; dene?: string; sor?: string; istem?: string; dogrula?: string; renk?: 'brand' | 'accent' | 'violet' | 'emerald' | 'rose' | 'amber' | 'teal'; }
const { n, title, fikir, dene, sor, istem, dogrula, renk = 'brand' } = Astro.props;
const COLOR = {
  brand: 'var(--color-brand-2)', accent: 'var(--color-accent)', violet: 'var(--mod-violet)', emerald: 'var(--mod-emerald)',
  rose: 'var(--mod-rose)', amber: 'var(--mod-amber)', teal: 'var(--mod-teal)',
}[renk];
const hasFoot = dene || sor || istem || dogrula;
---
<section class="kapsul" style={`--kapsul:${COLOR}`} aria-label={`Kapsül${n ? ` ${n}` : ''}: ${title}`}>
  <header class="kapsul-head">
    {n !== undefined && <span class="kapsul-n" aria-hidden="true">{n}</span>}
    <div class="min-w-0">
      <p class="kapsul-label">Kapsül</p>
      <h4 class="kapsul-title">{title}</h4>
      {fikir && <p class="kapsul-fikir">{fikir}</p>}
    </div>
  </header>
  <div class="kapsul-body"><slot /></div>
  {hasFoot && (
    <footer class="kapsul-foot">
      {dene && <p><span class="kapsul-tag kapsul-tag-dene">Dene</span><span>{dene}</span></p>}
      {(sor || istem) && (
        <div class="kapsul-sor">
          <p><span class="kapsul-tag kapsul-tag-sor">Sor</span><span>{sor ?? 'Asistana (Java Hocam becerisi) şu istemi verin:'}</span></p>
          {istem && <pre class="kapsul-istem"><code>{istem}</code></pre>}
        </div>
      )}
      {dogrula && <p><span class="kapsul-tag kapsul-tag-dogrula">Doğrula</span><span>{dogrula}</span></p>}
    </footer>
  )}
</section>
