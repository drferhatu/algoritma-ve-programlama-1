---
/** Portfolyo: giriş, kilometre taşları zaman çizelgesi ve kurallar. course.json → portfolio */
import { portfolio, weekHref, labLine, formatDayDate, getTheoryDate } from '@/lib/site';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const ms = [...portfolio.milestones].sort((a, b) => a.week - b.week);
---
{(ms.length > 0 || portfolio.intro) && (
  <section aria-labelledby="portfolyo" class="not-prose">
    <div class="mb-6">
      <p class="eyebrow">Portfolyo</p>
      <h2 id="portfolyo" class="display mt-1 text-2xl md:text-3xl">Dönem boyunca büyüyen bir kod portfolyosu</h2>
      {portfolio.intro && <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-2">{portfolio.intro}</p>}
    </div>

    {ms.length > 0 && (
      <ol class="relative space-y-6 border-l-2 border-line pl-6 sm:pl-8">
        {ms.map((m) => {
          const theory = getTheoryDate(m.week);
          const labs = labLine(m.week);
          return (
            <li class="relative">
              <span class="absolute -left-[calc(1.5rem+9px)] top-1.5 grid size-4 place-items-center rounded-full border-2 border-paper bg-accent ring-4 ring-accent-soft sm:-left-[calc(2rem+9px)]" aria-hidden="true"></span>
              <div class="rounded-2xl border border-line bg-white p-5 shadow-soft">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="rounded-full bg-accent px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-[0.12em] text-white">{m.id}</span>
                  <a href={weekHref(m.week)} class="text-xs font-semibold text-ink-3 hover:text-brand">Hafta {m.week}</a>
                  {theory && <span class="text-xs text-ink-3">· Teori {formatDayDate(theory)}</span>}
                  {labs && <span class="text-xs text-ink-3">· Lab {labs}</span>}
                </div>
                <h3 class="mt-2 font-display text-lg font-semibold leading-tight text-ink">{m.title}</h3>
                {!compact && <p class="mt-1.5 text-[14px] leading-relaxed text-ink-2">{m.desc}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    )}

    {!compact && portfolio.rules.length > 0 && (
      <div class="mt-8 rounded-2xl border border-line bg-paper-2/60 p-5">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-ink-3">Portfolyo kuralları</p>
        <ul class="mt-3 space-y-2 text-[14px] leading-relaxed text-ink-2">
          {portfolio.rules.map((r) => (
            <li class="flex gap-2.5"><span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span><span>{r}</span></li>
          ))}
        </ul>
      </div>
    )}
  </section>
)}
