---
import type { Week } from '@/lib/site';
import { moduleOf, moduleColorVar, weekHref, scheduleOf, formatDayDate, labLine, milestoneOf, STATUS_LABEL } from '@/lib/site';
import ModuleChip from './ModuleChip.astro';

interface Props { week: Week; compact?: boolean; }
const { week, compact = false } = Astro.props;
const m = moduleOf(week.data.module);
const s = scheduleOf(week.data.week);
const theory = formatDayDate(s?.theory.A);
const lab = labLine(week.data.week);
const statusLabel = s && s.status !== 'normal' ? STATUS_LABEL[s.status] : '';
const ms = milestoneOf(week.data.milestone);
---
<a
  href={weekHref(week.data.week)}
  class="group relative flex h-full flex-col rounded-2xl border border-line bg-white p-5 shadow-soft transition-all hover:-translate-y-0.5 hover:border-line-2 hover:shadow-lift focus-visible:outline-accent"
  style={`--mod:${moduleColorVar(m)}`}
>
  <span class="absolute inset-y-5 left-0 w-[3px] rounded-r bg-[var(--mod)]" aria-hidden="true"></span>
  <div class="flex items-start justify-between gap-3">
    <span class="font-display text-3xl font-medium leading-none text-ink">{String(week.data.week).padStart(2, '0')}</span>
    <div class="flex flex-col items-end gap-1 text-right">
      <ModuleChip module={m} />
      {theory && <span class="text-[11px] font-medium text-ink-3"><span class="text-ink-2">Teori</span> {theory}</span>}
      {lab && <span class="text-[11px] font-medium text-ink-3"><span class="text-ink-2">Lab</span> {lab}</span>}
    </div>
  </div>
  <h3 class="mt-4 font-sans text-[15px] font-bold leading-snug text-ink group-hover:text-brand">{week.data.title}</h3>
  {!compact && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-2">{week.data.description}</p>}
  <div class="mt-auto flex flex-wrap items-center gap-2 pt-4 text-[11px] font-medium">
    {week.data.exam && <span class="rounded-full bg-accent-soft px-2 py-0.5 text-accent">Sınav</span>}
    {ms && <span class="rounded-full bg-accent px-2 py-0.5 text-white">Portfolyo {ms.id}</span>}
    {statusLabel && <span class="rounded-full bg-paper-2 px-2 py-0.5 text-ink-2">{statusLabel}</span>}
    {s?.note && !week.data.exam && <span class="text-ink-3">{s.note}</span>}
    <span class="ml-auto text-ink-3 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
  </div>
</a>
