---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Roadmap from '@/components/Roadmap.astro';
import { modules, getWeeksSorted, href, sections, assistant, TOTAL_WEEKS, scheduleOf, formatDayDate, milestoneOf, STATUS_LABEL, weekHref, labHref } from '@/lib/site';
const weeks = await getWeeksSorted();
const byNum = new Map(weeks.map((w) => [w.data.week, w]));
const rows = Array.from({ length: TOTAL_WEEKS }, (_, i) => i + 1).map((n) => ({ n, w: byNum.get(n), s: scheduleOf(n) }));
---
<BaseLayout title="Ders Akışı" description={`${TOTAL_WEEKS} haftalık Algoritma ve Programlama I dersinin modül bazında yol haritası; teori ve laboratuvar tarihleri.`}>
  <div class="wrap py-14 md:py-20">
    <SectionHeading eyebrow="Ders Akışı" title="Dönemin tamamı tek bakışta"
      lede={`Ders ${TOTAL_WEEKS} hafta ve ${modules.length} modülden oluşur. Teori Cuma günü işlenir (A ${sections.find((s) => s.id === 'A')?.theory.replace(/^\S+\s*/, '')}, B ${sections.find((s) => s.id === 'B')?.theory.replace(/^\S+\s*/, '')}); aynı konunun laboratuvarı bir hafta sonra yapılır (A ${sections.find((s) => s.id === 'A')?.lab}, B ${sections.find((s) => s.id === 'B')?.lab}).`} />
    <nav aria-label="Modüller" class="mt-10 flex flex-wrap gap-2">
      {modules.map((m, i) => (
        <a href={`#${m.slug}`} class="rounded-full border border-line bg-white px-3 py-1.5 text-xs font-semibold text-ink-2 hover:border-ink hover:text-ink" style={`border-left: 3px solid var(--mod-${m.color})`}>{i + 1}. {m.short}</a>
      ))}
      <a href="#takvim" class="rounded-full border border-line bg-white px-3 py-1.5 text-xs font-semibold text-ink-2 hover:border-ink hover:text-ink">Takvim tablosu</a>
    </nav>
  </div>

  <div class="wrap pb-16">
    <!-- Modül anchor'ları Roadmap içindeki modül başlıklarına karşılık gelir -->
    {modules.map((m) => <span id={m.slug} class="block -mt-24 pt-24" aria-hidden="true"></span>)}
    <Roadmap weeks={weeks} />
  </div>

  <div class="wrap pb-24">
    <h2 id="takvim" class="display scroll-mt-28 text-2xl md:text-3xl">Haftalık takvim</h2>
    <p class="mt-2 text-sm text-ink-2">Lab sütunu, o haftanın konusunun laboratuvarda uygulandığı tarihi gösterir; teoriden bir hafta sonradır. Labları {assistant.name} yürütür.</p>
    <div class="mt-6 overflow-x-auto rounded-2xl border border-line bg-white">
      <table class="w-full min-w-[640px] text-sm">
        <thead class="bg-paper-2/70 text-left text-xs uppercase tracking-wider text-ink-3">
          <tr><th class="px-4 py-3 font-semibold">Hafta</th><th class="px-4 py-3 font-semibold">Konu</th><th class="px-4 py-3 font-semibold">Teori (A · B)</th><th class="px-4 py-3 font-semibold">Lab A</th><th class="px-4 py-3 font-semibold">Lab B</th><th class="px-4 py-3 font-semibold">Not</th></tr>
        </thead>
        <tbody>
          {rows.map(({ n, w, s }) => {
            const ms = milestoneOf(w?.data.milestone);
            const off = s && s.status !== 'normal';
            return (
              <tr class:list={['border-t border-line align-top', off && 'bg-paper-2/40']}>
                <td class="px-4 py-3 font-bold text-ink">{n}</td>
                <td class="px-4 py-3">
                  {w ? <a href={weekHref(n)} class="font-semibold text-ink hover:text-brand">{w.data.title}</a> : <span class="text-ink-3">Hazırlanıyor</span>}
                  {ms && <span class="ml-2 rounded-full bg-accent px-2 py-0.5 text-[11px] font-bold text-white">{ms.id}</span>}
                  {w?.data.exam && <span class="ml-2 rounded-full bg-accent-soft px-2 py-0.5 text-[11px] font-bold text-accent">Sınav</span>}
                </td>
                <td class="px-4 py-3 text-ink-2">{formatDayDate(s?.theory.A) || '—'}{s?.theory.B && s.theory.B !== s.theory.A ? ` · ${formatDayDate(s.theory.B)}` : ''}</td>
                <td class="px-4 py-3 text-ink-2">{s?.lab.A ? <a href={labHref(n)} class="hover:text-brand">{formatDayDate(s.lab.A)}</a> : '—'}</td>
                <td class="px-4 py-3 text-ink-2">{s?.lab.B ? <a href={labHref(n)} class="hover:text-brand">{formatDayDate(s.lab.B)}</a> : '—'}</td>
                <td class="px-4 py-3 text-xs text-ink-3">{off && <span class="font-semibold text-ink-2">{STATUS_LABEL[s!.status]} </span>}{s?.note}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="mt-8 text-sm text-ink-3">Tarihler akademik takvime göre güncellenir. Bir hafta tatile denk gelirse veya ertelenirse burada ve ilgili haftanın sayfasında belirtilir. Kart görünümü için <a class="link" href={href('/haftalar')}>tüm haftalar</a> sayfasına bakabilirsiniz.</p>
  </div>
</BaseLayout>
